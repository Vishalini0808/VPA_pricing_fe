                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- Dealer Cost -->
                        <table:Column
                            width="130px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Dealer Cost (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>dealerCost}"
                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- NDP -->
                        <table:Column
                            width="120px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="NDP (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>ndp}"
                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- Dealer Margin -->
                        <table:Column
