<mvc:View controllerName="vpapricing.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:layout="sap.ui.layout">

    <f:DynamicPage
        id="pricingPage"
        fitContent="true"
        class="pricingView">

        <!-- Page Header -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Vehicle Pricing Calculation"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox class="sapUiSmallMargin">

                <!-- ===================== -->
                <!-- Selection Section      -->
                <!-- ===================== -->

                <Panel
                    expandable="true"
                    expanded="true"
                    class="selectionPanel sapUiSmallMarginBottom">

                    <headerToolbar>
                        <Toolbar>
                            <core:Icon
                                src="sap-icon://filter-fields"
                                class="sapUiTinyMarginEnd"/>

                            <Title text="Selection"/>
                        </Toolbar>
                    </headerToolbar>
                    <layout:Grid
                        defaultSpan="XL3 L3 M6 S12"
                        hSpacing="1"
                        vSpacing="1">

                        <!-- Region -->
                        <VBox>
                            <Label
                                text="Region"
                                required="true"/>

                             <ComboBox
                                id="regionSelect"
                                width="100%"
                                selectedKey="{viewModel>/region}"
                                items="{
                                    path: '/Regions'
                                }">

                                    <core:Item
                                        key="{regionCode}"
                                        text="{regionName}"/>

                            </ComboBox>
                        </VBox>

                        <!-- Order Type -->
                        <VBox>
                            <Label
                                text="Order Type"
                                required="true"/>

                            <Select
                                id="orderTypeSelect"
                                width="100%"
                                selectedKey="{viewModel>/orderType}"
                                change=".onOrderTypeChange">

                                <items>
                                    <core:Item
                                        key=""
                                        text="Select Order Type"/>
                                    <core:Item
                                        key="MTS"
                                        text="MTS"/>
                                    <core:Item
                                        key="MTO"
                                        text="MTO"/>
                                    <core:Item
                                        key="EV"
                                        text="EV"/>
                                    <core:Item
                                        key="GEM"
                                        text="GeM"/>
                                    <core:Item
                                        key="CSD"
                                        text="CSD"/>
                                </items>

                            </Select>
                        </VBox>

                        <!-- Model Codes -->
                        <VBox>
                            <Label
                                text="Model Code(s)"
                                required="true"/>

                            <MultiComboBox
                                id="modelCodeMultiCombo"
                                width="100%"
                                selectedKeys="{viewModel>/models}"
                                items="{viewModel>/availableModels}">

                                <core:Item
                                        key="{viewModel>modelCode}"
                                        text="{viewModel>modelCode}"/>

                            </MultiComboBox>
                        </VBox>

                        <!-- Effective Date -->
                        <VBox>
                            <Label
                                text="Effective Date"
                                required="true"/>

                            <DatePicker
                                id="effectiveDate"
                                width="100%"
                                value="{viewModel>/effectiveDate}"
                                valueFormat="dd.MM.yyyy"
                                displayFormat="dd.MM.yyyy"/>
                        </VBox>

                        <!-- Status -->
                        <VBox>
                            <Label text="Status Filter"/>

                            <Select
                                id="statusSelect"
                                width="100%"
                                selectedKey="{viewModel>/status}">

                                <items>
                                    <core:Item
                                        key="ACTIVE"
                                        text="Active"/>

                                    <core:Item
                                        key="INACTIVE"
                                        text="Inactive"/>

                                    <core:Item
                                        key="ALL"
                                        text="All"/>
                                </items>

                            </Select>
                        </VBox>

                        <!-- Submitter Email -->
                        <!-- <VBox>
                            <Label text="Submitter E-mail"/>

                            <Input
                                id="submitterEmail"
                                width="100%"
                                value="{viewModel>/submitterEmail}"
                                editable="false"/>
                        </VBox> -->

                        <!-- Buttons -->
                        <HBox
                            class="sapUiSmallMarginTop"
                            alignItems="End"
                            justifyContent="End">

                            <Button
                                text="Get Data"
                                type="Emphasized"
                                icon="sap-icon://search"
                                press=".onGetData"
                                class="sapUiTinyMarginEnd"/>

                            <Button
                                text="Clear"
                                icon="sap-icon://reset"
                                press=".onClear"/>

                        </HBox>

                    </layout:Grid>

                </Panel>



                <!-- ===================== -->
                <!-- Pricing Results        -->
                <!-- ===================== -->

                <Panel
                    id="pricingPanel"
                    expandable="true"
                    expanded="false"
                    class="pricingResultsPanel sapUiSmallMarginTop">

                    <headerToolbar>
                        <Toolbar>
                            <core:Icon
                                src="sap-icon://table-view"
                                class="sapUiTinyMarginEnd"/>

                            <Title text="Pricing Results"/>
                        </Toolbar>
                    </headerToolbar>

                    <!-- Toolbar -->
                    <OverflowToolbar>

                        <ToolbarSpacer/>

                        <Button
                            text="Calculate"
                            type="Emphasized"
                            icon="sap-icon://simulate"
                            press=".onCalculate"/>

                        <Button
                            text="Submit"
                            icon="sap-icon://paper-plane"
                            press=".onSubmit"
                            class="sapUiTinyMarginBegin"/>

                        <Button
                            text="Apply to All Region"
                            icon="sap-icon://copy"
                            press=".onApplyToAllRegion"
                            class="sapUiTinyMarginBegin"/>

                        <Button
                            text="Delete"
                            type="Reject"
                            icon="sap-icon://delete"
                            press=".onDelete"
                            class="sapUiTinyMarginBegin"/>

                    </OverflowToolbar>


                    <!-- =========================
                        PRICING RESULTS TABLE
                        ========================= -->
                    <table:Table
                        id="pricingTable"
                        class="pricingTable"
                        rows="{pricingModel>/results}"
                        selectionMode="MultiToggle"
                        selectionBehavior="RowSelector"
                        enableColumnReordering="true"
                        enableCellFilter="false"
                        alternateRowColors="true"
                        fixedColumnCount="1"
                        width="100%">

                        <!-- =====================================================
                            COMMON COLUMNS
                            ===================================================== -->

                        <!-- Model -->
                        <table:Column 
                            width="180px">
                            <Label text="Model"/>
                            <table:template>
                                <Text text="{pricingModel>modelCode}"/>
                            </table:template>
                        </table:Column>

                        <!-- Region -->
                        <table:Column width="100px">
                            <Label text="Region"/>
                            <table:template>
                                <Text text="{pricingModel>regionCode}"/>
                            </table:template>
                        </table:Column>

                        <!-- Order Type -->
                        <table:Column width="100px">
                            <Label text="Order Type"/>
                            <table:template>
                                <Text text="{pricingModel>orderType}"/>
                            </table:template>
                        </table:Column>


                        <!-- =====================================================
                            MTS INPUT SECTION
                            ===================================================== -->

                        <!-- Input NSP -->
                        <table:Column
                            width="130px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Input NSP (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>inputNSP}"
                                    type="Number"
                                    editable="true"
                                    change=".onInputChange"/>
                            </table:template>

                        </table:Column>


                        <!-- Target Ex-Showroom -->
                        <!-- <table:Column
                            width="160px"
                            visible="{= ${viewModel>/orderType} === 'MTS' }">

                            <Label text="Target Ex-Showroom (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>exShowroomInput}"
                                    type="Number"
                                    editable="false"
                                    change=".onInputChange"/>
                            </table:template>

                        </table:Column> -->


                        <!-- =====================================================
                            MTS / EV MASTER VALUES
                            ===================================================== -->

                        <!-- Helmet -->
                        <table:Column
                            width="110px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Helmet (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>helmet}"
                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- Transportation -->
                        <table:Column
                            width="130px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Transportation (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>transportation}"
                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- Other Expenses -->
                        <table:Column
                            width="140px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Other Expenses (₹)"/>

                            <table:template>
