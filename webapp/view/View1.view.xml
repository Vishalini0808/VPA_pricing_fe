                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- Helmet Margin -->
                        <table:Column
                            width="120px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Helmet Margin (₹)"/>

                            <table:template>
                                <Input
                                    value="{pricingModel>helmetMargin}"
                                    editable="false"/>
                            </table:template>

                        </table:Column>


                        <!-- =====================================================
                            MTS / EV CALCULATED VALUES
                            ===================================================== -->

                        <!-- Actual NSP -->
                        <table:Column
                            width="130px"
                            visible="{= ${viewModel>/orderType} === 'MTS' || ${viewModel>/orderType} === 'EV' }">

                            <Label text="Actual NSP (₹)"/>

                            <table:template>
                                <Input
